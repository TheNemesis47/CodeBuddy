{
  "name": "question-opens-streams-and-folds",
  "description": "An explicit answer opens the panel, stays open while streaming, folds to peek 20 s after it ends, hides 8 s later.",
  "delays": {
    "expanded_to_peek": 20,
    "peek_to_hidden": 8
  },
  "steps": [
    {
      "connection": "connected"
    },
    {
      "expect": {
        "state": "hidden",
        "mood": "idle"
      }
    },
    {
      "message": {
        "v": 0,
        "type": "answer_start",
        "id": "a",
        "kind": "question",
        "title": "perché?"
      }
    },
    {
      "expect": {
        "state": "expanded",
        "mood": "thinking",
        "peek_status": "…"
      }
    },
    {
      "message": {
        "v": 0,
        "type": "answer_delta",
        "id": "a",
        "text": "Perché…"
      }
    },
    {
      "advance": 300
    },
    {
      "expect": {
        "state": "expanded",
        "text": "Perché…"
      }
    },
    {
      "message": {
        "v": 0,
        "type": "answer_end",
        "id": "a",
        "model": "m",
        "first_token_ms": 1,
        "total_ms": 2,
        "tokens": {
          "in": 1,
          "out": 1
        }
      }
    },
    {
      "expect": {
        "mood": "happy",
        "peek_status": "✓"
      }
    },
    {
      "advance": 20
    },
    {
      "expect": {
        "state": "peek"
      }
    },
    {
      "advance": 8
    },
    {
      "expect": {
        "state": "hidden"
      }
    }
  ]
}
