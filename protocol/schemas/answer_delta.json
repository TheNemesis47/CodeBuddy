{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebuddy/protocol/v0/answer_delta.json",
  "title": "answer_delta",
  "description": "brain → notch. The next chunk of answer text (markdown).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "text"
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "answer_delta"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "text": {
      "type": "string"
    }
  }
}
