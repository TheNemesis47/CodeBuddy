{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebuddy/protocol/v0/error.json",
  "title": "error",
  "description": "brain → client. Something failed; id is null when it isn't tied to a request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "message"
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "error"
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}
