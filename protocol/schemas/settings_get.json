{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebuddy/protocol/v0/settings_get.json",
  "title": "settings_get",
  "description": "ide → brain. Ask for the current settings; the brain answers `settings` with the same id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id"
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "settings_get"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
