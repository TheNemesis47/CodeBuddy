{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebuddy/protocol/v0/models.json",
  "title": "models",
  "description": "brain → ide. The answer to `models_get`: model ids, or why they couldn't be listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "models",
    "error"
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "models"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
