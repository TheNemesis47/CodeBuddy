{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codebuddy/protocol/v0/project_map.json",
  "title": "project_map",
  "description": "ide → brain. File tree + top-level signatures; resent only when its hash changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "hash",
    "tree",
    "symbols"
  ],
  "properties": {
    "v": {
      "const": 0
    },
    "type": {
      "const": "project_map"
    },
    "hash": {
      "type": "string",
      "minLength": 1
    },
    "tree": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
